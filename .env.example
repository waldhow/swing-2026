#--------------------------------------------------------------------
# Swing Golf & Lounge — miljövariabler
# Kopiera till .env och fyll i. .env checkas aldrig in.
# Värden utan förval nedan måste sättas i produktion.
#--------------------------------------------------------------------

# development lokalt, production på Loopia.
CI_ENVIRONMENT = production

# Sajtens adress med avslutande snedstreck.
app.baseURL = 'https://swinggolf.se/'
app.forceGlobalSecureRequests = true

# Indexering i sökmotorer. Sätt true först när sajten är lanserad på
# rätt domän — false ger "Disallow: /" och noindex på alla sidor.
seo.indexable = false

#--------------------------------------------------------------------
# Databas (MariaDB hos Loopia — värdnamnet visas i Loopia Kundzon)
#--------------------------------------------------------------------
database.default.hostname = mysqlXXX.loopia.se
database.default.database =
database.default.username =
database.default.password =
database.default.DBDriver = MySQLi
database.default.port = 3306
database.default.DBDebug = false

#--------------------------------------------------------------------
# Kryptering (personnummer vid friskvårdsköp). Generera med:
#   php spark key:generate --show
#--------------------------------------------------------------------
encryption.key =

#--------------------------------------------------------------------
# E-post via Loopias SMTP. Avsändaren måste vara en brevlåda hos Loopia.
#--------------------------------------------------------------------
email.protocol = smtp
email.SMTPHost = mailcluster.loopia.se
email.SMTPPort = 587
email.SMTPCrypto = tls
email.SMTPUser = info@swinggolf.se
email.SMTPPass =
email.fromEmail = info@swinggolf.se
email.fromName = 'Swing Golf & Lounge'

#--------------------------------------------------------------------
# Förfrågningar (kontakt/offert) mejlas hit.
#--------------------------------------------------------------------
inquiries.notifyTo = info@swinggolf.se

#--------------------------------------------------------------------
# Beställningar → swing-order (se docs/swing-order.md)
#--------------------------------------------------------------------
# mail = strukturerat "Order"-mejl till brevlådan som swing-order synkar.
# api  = HTTP POST till swing-order (kräver endpoint i swing-order).
orders.channel = mail
# Brevlådan som swing-order läser via IMAP. Tom = beställningsformulären döljs.
orders.mailTo =
# Endast för api-kanalen:
# orders.apiUrl = https://crew.swinggolf.se/api/integrations/orders
# orders.apiToken =
# Direktköp av friskvårdspott med personnummer (kräver även encryption.key):
orders.friskvardDirect = true

#--------------------------------------------------------------------
# Bokning — byts här när det egna bokningssystemet lanseras (2027).
# Tom = alla boka-knappar leder till /boka/.
#--------------------------------------------------------------------
# booking.bookingUrl = https://book.sweetspot.io/clubs/swing-golf-lounge

#--------------------------------------------------------------------
# Admin — engångstoken för /admin/setup/?token=... (minst 24 tecken).
# Generera med: php -r "echo bin2hex(random_bytes(24));"
# Töm värdet när första användaren är skapad om setup inte behövs.
#--------------------------------------------------------------------
admin.setupToken =

#--------------------------------------------------------------------
# Loggning: 4 = fel och kritiska händelser
#--------------------------------------------------------------------
logger.threshold = 4
